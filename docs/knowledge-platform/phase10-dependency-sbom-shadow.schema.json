{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puddingai.local/schemas/phase10-dependency-sbom-shadow.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "status",
    "activation_allowed",
    "execution_allowed",
    "source_repository",
    "source_revision",
    "input_digests",
    "python_component_count",
    "node_component_count",
    "node_manifests_dependency_free",
    "dependency_resolution",
    "sbom_format",
    "sbom_digest",
    "sbom",
    "replay_consistent",
    "network_contacted",
    "dependency_install_performed",
    "independent_repository_verified",
    "release_artifact_generated",
    "scope",
    "report_digest"
  ],
  "properties": {
    "format": {"const": "agent-knowledge-platform-phase10-dependency-sbom-shadow/v1"},
    "status": {"const": "PHASE10_DEPENDENCY_SBOM_SHADOW_PASS_NOT_ACTIVATABLE"},
    "activation_allowed": {"const": false},
    "execution_allowed": {"const": false},
    "source_repository": {"const": "PuddingClaw"},
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/+@-]+$"},
    "input_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "python_component_count": {"type": "integer", "minimum": 0},
    "node_component_count": {"type": "integer", "minimum": 0},
    "node_manifests_dependency_free": {"const": true},
    "dependency_resolution": {"const": "python-uv-lock-plus-dependency-free-platform-node-manifests"},
    "sbom_format": {"const": "CycloneDX/1.5"},
    "sbom_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sbom": {
      "type": "object",
      "required": ["bomFormat", "components", "dependencies", "metadata", "serialNumber", "specVersion", "version"],
      "properties": {
        "bomFormat": {"const": "CycloneDX"},
        "specVersion": {"const": "1.5"},
        "version": {"const": 1},
        "serialNumber": {"type": "string", "pattern": "^urn:uuid:[0-9a-f]{32}$"},
        "components": {"type": "array", "minItems": 1},
        "dependencies": {"type": "array", "minItems": 1},
        "metadata": {"type": "object"}
      },
      "additionalProperties": true
    },
    "replay_consistent": {"const": true},
    "network_contacted": {"const": false},
    "dependency_install_performed": {"const": false},
    "independent_repository_verified": {"const": false},
    "release_artifact_generated": {"const": false},
    "scope": {"type": "string", "minLength": 1},
    "report_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
